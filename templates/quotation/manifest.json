{
  "schemaVersion": 1,
  "id": "quotation",
  "name": "Starter quotation",
  "version": "1.0.0",
  "license": "CC-BY-4.0",
  "creator": "DocFlow Local Contributors",
  "attribution": "DocFlow Local starter template — https://docflowlocal.com",
  "locale": "en",
  "template": "starter.docx",
  "sample": "sample.csv",
  "filenamePattern": "{{quoteNumber}}-{{customerName}}",
  "fields": [
    { "name": "quoteNumber", "type": "string", "required": true },
    { "name": "quoteDate", "type": "date", "required": true },
    { "name": "customerName", "type": "string", "required": true },
    { "name": "customerEmail", "type": "string", "required": false },
    {
      "name": "items",
      "type": "array",
      "required": true,
      "fields": [
        { "name": "description", "type": "string", "required": true },
        { "name": "quantity", "type": "number", "required": true },
        { "name": "unitPrice", "type": "number", "required": true },
        { "name": "lineTotal", "type": "number", "required": true }
      ]
    },
    { "name": "showFlatItem", "type": "boolean", "required": false },
    { "name": "itemDescription", "type": "string", "required": false },
    { "name": "itemQuantity", "type": "number", "required": false },
    { "name": "itemUnitPrice", "type": "number", "required": false },
    { "name": "itemLineTotal", "type": "number", "required": false },
    { "name": "subtotal", "type": "number", "required": true },
    { "name": "showDiscount", "type": "boolean", "required": false },
    { "name": "discount", "type": "number", "required": false },
    { "name": "taxRate", "type": "number", "required": true },
    { "name": "total", "type": "number", "required": true },
    { "name": "notes", "type": "string", "required": false }
  ]
}
