{
  "schemaVersion": 1,
  "id": "invoice",
  "name": "Starter invoice",
  "version": "1.0.0",
  "license": "CC-BY-4.0",
  "creator": "DocFlow Local Contributors",
  "attribution": "DocFlow Local starter template — https://docflowlocal.com",
  "locale": "en",
  "template": "starter.docx",
  "sample": "sample.csv",
  "filenamePattern": "{{invoiceNumber}}-{{billTo}}",
  "fields": [
    { "name": "invoiceNumber", "type": "string", "required": true },
    { "name": "invoiceDate", "type": "date", "required": true },
    { "name": "dueDate", "type": "date", "required": true },
    { "name": "billTo", "type": "string", "required": true },
    {
      "name": "items",
      "type": "array",
      "required": true,
      "fields": [
        { "name": "description", "type": "string", "required": true },
        { "name": "quantity", "type": "number", "required": true },
        { "name": "unitPrice", "type": "number", "required": true },
        { "name": "lineTotal", "type": "number", "required": true }
      ]
    },
    { "name": "subtotal", "type": "number", "required": true },
    { "name": "showTax", "type": "boolean", "required": false },
    { "name": "tax", "type": "number", "required": false },
    { "name": "total", "type": "number", "required": true },
    { "name": "paymentReference", "type": "string", "required": false }
  ]
}
