{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docflowlocal.com/schemas/generate-request-v1.json",
  "title": "DocFlow Core generation request v1",
  "description": "Public createEngine().generate()/validate() job shape. Buffer-like values use x-docflow-runtimeType because they are Node.js values, not JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "template"],
  "oneOf": [
    {
      "required": ["data"],
      "properties": { "data": true }
    },
    {
      "required": ["rows"],
      "properties": { "rows": true }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "data": { "$ref": "#/$defs/fileDescriptor" },
    "rows": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "propertyNames": {
          "not": { "enum": ["__proto__", "prototype", "constructor"] }
        }
      }
    },
    "dataSource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "dataSourceOptions": { "type": "object" },
    "template": { "$ref": "#/$defs/fileDescriptor" },
    "mappings": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" },
              { "$ref": "#/$defs/mapping" }
            ]
          }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/mappingEntry" }
        }
      ]
    },
    "computedFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/computedRule" }
    },
    "conditionalFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/conditionalRule" }
    },
    "transforms": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9._-]{0,63}$"
              },
              "options": {}
            }
          }
        ]
      }
    },
    "requiredFields": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string", "maxLength": 500 },
        "folderPattern": { "type": "string", "maxLength": 500 },
        "onConflict": { "enum": ["error", "suffix", "overwrite"] }
      }
    },
    "namingPattern": { "type": "string", "maxLength": 500 },
    "folderPattern": { "type": "string", "maxLength": 500 },
    "strict": { "type": "boolean" },
    "assets": {
      "type": "object",
      "description": "Image values are Buffer, data URL, or {data,mimeType} runtime values."
    },
    "signature": {
      "description": "A Buffer, image data URL, or {data,mimeType} runtime value.",
      "x-docflow-runtimeType": ["Buffer", "string", "ImageDescriptor"]
    },
    "imageWidth": { "type": "number", "exclusiveMinimum": 0 },
    "imageHeight": { "type": "number", "exclusiveMinimum": 0 }
  },
  "$defs": {
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "fileDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "bytes"],
      "properties": {
        "filename": { "$ref": "#/$defs/filename" },
        "mediaType": { "type": "string", "maxLength": 255 },
        "bytes": {
          "description": "A Node.js Buffer or Uint8Array.",
          "x-docflow-runtimeType": ["Buffer", "Uint8Array"]
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["source", "literal", "expression"] },
        "source": { "type": "string" },
        "value": {},
        "expression": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "required": ["source"],
          "properties": { "kind": { "enum": ["source"] } }
        },
        {
          "required": ["expression"],
          "properties": { "kind": { "enum": ["expression"] } }
        },
        {
          "required": ["kind"],
          "properties": { "kind": { "const": "literal" } }
        }
      ]
    },
    "mappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "templateField": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "value": {},
        "expression": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["source", "literal", "expression"] }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["target"] },
            { "required": ["templateField"] },
            { "required": ["field"] }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["source"],
              "properties": { "kind": { "enum": ["source"] } }
            },
            {
              "required": ["expression"],
              "properties": { "kind": { "enum": ["expression"] } }
            },
            {
              "required": ["kind"],
              "properties": { "kind": { "const": "literal" } }
            }
          ]
        }
      ]
    },
    "computedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "digits": { "type": "integer", "minimum": 0, "maximum": 12 }
      }
    },
    "conditionalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "whenTrue": {},
        "whenFalse": {}
      }
    }
  }
}
