{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docflowlocal.com/schemas/plugin-manifest-v1.json",
  "title": "DocFlow plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "apiVersion",
    "entry",
    "capabilities",
    "permissions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "const": "1" },
    "entry": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:c?js|mjs)$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "data-source",
          "transform",
          "formatter",
          "output-sink"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 255 }
        },
        "filesystem": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["read", "write"] }
        }
      }
    }
  }
}
