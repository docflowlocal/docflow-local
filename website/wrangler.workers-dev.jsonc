{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docflowlocal-site",
  "main": "./src/worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
