{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "docflowlocal-site",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docflowlocal.com",
      "custom_domain": true
    },
    {
      "pattern": "www.docflowlocal.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
